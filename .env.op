# 1Password template: run commands as
#   op run --env-file=.env.op -- npm run kroger:auth
# Secrets never land on disk. Update the item path if yours differs.
KROGER_CLIENT_ID=op://tynet/kroger.developer/client_id
KROGER_CLIENT_SECRET=op://tynet/kroger.developer/client_secret
KROGER_REDIRECT_URI=http://localhost:8000/callback
ZIP_CODE=80126
# Wildcat Reserve, 2205 W Wildcat Reserve Pkwy, Highlands Ranch 80129
KROGER_LOCATION_ID=62000008

# Slack (Socket Mode) — see docs/slack.md
SLACK_BOT_TOKEN=op://tynet/slack.mealplanner/bot_token
SLACK_APP_TOKEN=op://tynet/slack.mealplanner/app_token
SLACK_USER_ID=op://tynet/slack.mealplanner/user_id
# Everyone else who may plan, edit and approve (comma-separated member IDs).
SLACK_ALLOWED_USERS=op://tynet/slack.mealplanner/allowed_users
# The shared private channel the weekly plan goes to. Unset = DM with SLACK_USER_ID.
SLACK_CHANNEL=op://tynet/slack.mealplanner/channel_id
