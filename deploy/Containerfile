# Build once, run forever: the agent is a single long-lived process that dials
# out to Slack and Kroger. It serves nothing, so the image has no EXPOSE.
FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
# better-sqlite3 compiles against this image's node; building it here is what
# keeps the runtime image free of a toolchain.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && npm ci \
 && rm -rf /var/lib/apt/lists/*

COPY tsconfig.json ./
COPY server ./server
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/server/dist ./server/dist
COPY --from=build /app/package.json ./package.json

# Everything that changes lives on the volume: the database, the Kroger refresh
# token the app rotates for itself, and the calendar snapshot.
ENV CLAUDE_GROCERY_DATA_DIR=/data \
    KROGER_TOKEN_FILE=/data/kroger-token.json \
    CALENDAR_EVENTS_FILE=/data/week-events.json

USER node
ENTRYPOINT ["node", "server/dist/slack/start.js"]
