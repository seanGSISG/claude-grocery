{
  "name": "claude-grocery",
  "version": "1.0.0",
  "description": "Claude Desktop MCP server for weekly meal planning with Colorado grocery delivery integration (King Soopers, Safeway, Walmart)",
  "type": "module",
  "main": "server/dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node server/dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector node server/dist/index.js",
    "inspect:dev": "npx @modelcontextprotocol/inspector node --env-file=.env server/dist/index.js",
    "kroger:auth": "npm run build && node server/dist/cli/kroger-auth.js",
    "kroger:smoke": "npm run build && node server/dist/cli/kroger-smoke.js",
    "history:import": "npm run build && node server/dist/cli/import-history.js",
    "recipes:import": "npm run build && node server/dist/cli/import-recipes.js",
    "plan:week": "npm run build && node server/dist/cli/plan-week.js",
    "slack:dev": "npm run build && node server/dist/slack/start.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "better-sqlite3": "^13.0.3",
    "uuid": "^11.1.0",
    "zod": "^3.24.2",
    "@slack/bolt": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.21.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "license": "MIT"
}
